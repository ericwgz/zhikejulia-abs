# Dedicated model configuration for ABS Lens. Never put credentials in static files.
ABS_API_HOST=127.0.0.1
ABS_API_PORT=8096
ABS_CATALOG_PATH=/opt/badrams/current/app/static/abs/catalog.json
ABS_API_DATA_DIR=/srv/badrams-data/abs-api
ABS_ALLOWED_ORIGINS=https://badrams.com,https://www.badrams.com
# Full HTTPS endpoint using the Chat Completions JSON format.
ABS_LLM_CHAT_URL=
ABS_LLM_API_KEY=
ABS_LLM_MODEL=
ABS_LLM_PROVIDER=
# Qwen mixed-thinking models: false for this non-streaming report UI.
ABS_LLM_ENABLE_THINKING=
ABS_LLM_DAILY_REQUEST_LIMIT=100
